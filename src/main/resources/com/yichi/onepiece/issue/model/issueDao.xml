<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yichi.onepiece.issue.model.IssueDao">
    <select id="listIssues" resultType="com.yichi.onepiece.issue.model.IssueListView" resultMap="issueListView">
        SELECT * FROM `issue`
        LEFT JOIN `action_lineage` on `issue`.`creation_record_id` = `action_lineage`.`id`
        <include refid="issueFilter">
            <property name="issueFilter" value="issueFilter"/>
        </include>
        ORDER BY
        <include refid="orderClause"/>
        LIMIT #{offset}, #{size}
    </select>

    <select id="searchCount" resultType="int">
        SELECT COUNT(*) FROM `issue`
        LEFT JOIN `action_lineage` on `issue`.`creation_record_id` = `action_lineage`.`id`
        <include refid="issueFilter">
            <property name="issueFilter" value="issueFilter"/>
        </include>
    </select>

    <select id="getIssueFullView" resultType="com.yichi.onepiece.issue.model.IssueFullView" resultMap="issueFullView">
        SELECT * FROM `issue`
        LEFT JOIN `action_lineage` on `issue`.`creation_record_id` = `action_lineage`.`id`
        WHERE `issue`.id = #{id}
    </select>

    <resultMap id="issueListView" type="com.yichi.onepiece.issue.model.IssueListView" autoMapping="true">
        <result column="id" property="id"/>
        <association column="creation_record_id" property="creationRecord"
                     select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
        />
        <association column="modification_record_id" property="modificationRecord"
                     select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
        />
    </resultMap>

    <resultMap id="issueFullView" type="com.yichi.onepiece.issue.model.IssueFullView" autoMapping="true" extends="issueListView">
        <association column="user_id" property="issueCreator"
                     select="com.yichi.onepiece.user.model.UserDao.getById"
        />
    </resultMap>

    <!-- Construct where clause -->
    <sql id="issueFilter">
        WHERE 1=1
        <if test="issueFilter.username != null and issueFilter.username != ''">
            <bind name="nameKeyLike" value="'%' + issueFilter.username + '%'"/>
            AND `username` like #{nameKeyLike}
        </if>
        <if test="issueFilter.nickname != null and issueFilter.nickname != ''">
            <bind name="nicknameKeyLike" value="'%' + issueFilter.nickname + '%'"/>
            AND `nickname` like #{nicknameKeyLike}
        </if>
        <if test="issueFilter.issueHeader != null and issueFilter.issueHeader != ''">
            <bind name="headerKeyLike" value="'%' + issueFilter.issueHeader + '%'"/>
            AND `issue_header` like #{headerKeyLike}
        </if>
        <if test="issueFilter.issueTypes != null and !issueFilter.issueTypes.isEmpty">
            AND `issue_type` IN
            <foreach item="issueType" collection="issueFilter.issueTypes" open="("
                     separator="," close=")">
                #{issueType}
            </foreach>
        </if>
        <if test="issueFilter.issueStatuses != null and !issueFilter.issueStatuses.isEmpty">
            AND `issue_status` IN
            <foreach item="issueStatus" collection="issueFilter.issueStatuses" open="("
                     separator="," close=")">
                #{issueStatus}
            </foreach>
        </if>
    </sql>

    <!-- Construct order by clause -->
    <sql id="orderClause">
        <choose>
            <when test="sortList == null or sortList.isEmpty">
                creation_record_id DESC
            </when>
            <otherwise>
                <foreach item="item" collection="sortList" separator=",">
                    ${item.sortKey} ${item.sortOrder}
                </foreach>
            </otherwise>
        </choose>
    </sql>
</mapper>