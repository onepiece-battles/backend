<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yichi.onepiece.fruit.model.FruitDao">
  <select id="list" resultMap="com.yichi.onepiece.fruit.model.FruitEntity">
    SELECT * FROM fruit
    <include refid="fruitFilter">
      <property name="filter" value="filter"/>
    </include>
    ORDER BY
    <include refid="orderClause"/>
    LIMIT #{offset}, #{size}
  </select>

  <!-- Construct where clause -->
  <sql id="fruitFilter">
    WHERE
    <if test="fruit.name != null and fruit.name != ''">
      <bind name="keyLike" value="'%' + fruit.name + '%"/>
      AND name like #{keyLike}
    </if>
    <if test="fruit.owner_id != null and fruit.owner_id != ''">
      <bind name="keyLike" value="'%' + fruit.owner_id + '%"/>
      AND owner_id like #{keyLike}
    </if>
  </sql>

  <!-- Construct order by clause -->
  <sql id="orderClause">
    <choose>
      <when test="sortList == null or sortList.isEmpty">
        creation_record_id DESC
      </when>
      <otherwise>
        <foreach item="item" collection="sortList" separator=",">
          ${item.sortKey} ${item.sortOrder}
        </foreach>
      </otherwise>
    </choose>
  </sql>
</mapper>