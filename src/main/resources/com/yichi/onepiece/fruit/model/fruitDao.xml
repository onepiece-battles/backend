<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yichi.onepiece.fruit.model.FruitDao">
    <select id="listFruits" resultType="com.yichi.onepiece.fruit.model.FruitListView" resultMap="fruitListView">
        SELECT * FROM `fruit`
        LEFT JOIN `action_lineage` on `fruit`.`creation_record_id` = `action_lineage`.`id`
        <include refid="fruitFilter">
            <property name="fruitFilter" value="fruitFilter"/>
        </include>
        ORDER BY
        <include refid="orderClause"/>
        LIMIT #{offset}, #{size}
    </select>

    <select id="searchCount" resultType="int">
        SELECT COUNT(*) FROM fruit
        LEFT JOIN `action_lineage` on `fruit`.`creation_record_id` = `action_lineage`.`id`
        <include refid="fruitFilter">
            <property name="fruitFilter" value="fruitFilter"/>
        </include>
    </select>

    <select id="getFruitFullViewById" resultType="com.yichi.onepiece.fruit.model.FruitFullView" resultMap="fruitFullView">
        SELECT * FROM `fruit`
        WHERE `fruit`.id = #{fruitId}
    </select>

    <resultMap id="fruitListView" type="com.yichi.onepiece.fruit.model.FruitListView" autoMapping="true">
        <result column="id" property="id"/>
        <association column="id" property="characters"
                     select="com.yichi.onepiece.character.model.dao.CharacterToFruitDao.listCharacterInFruitViewByFruitId"
        />
        <association column="creation_record_id" property="creationRecord"
                     select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
        />
        <association column="modification_record_id" property="modificationRecord"
                     select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
        />
    </resultMap>

    <resultMap id="fruitFullView" type="com.yichi.onepiece.fruit.model.FruitFullView" autoMapping="true" extends="fruitListView">
        <result column="id" property="id"/>
        <association column="id" property="characters"
                     select="com.yichi.onepiece.character.model.dao.CharacterToFruitDao.listCharacterInFruitViewByFruitId"
        />
    </resultMap>

    <!-- Construct where clause -->
    <sql id="fruitFilter">
        <where>
            <trim prefixOverrides="AND">
                <if test="fruitFilter.systemResource != null or fruitFilter.userId != null or (externalResourceIds != null and externalResourceIds.size > 0)">
                    (
                    <trim prefixOverrides="OR">
                        <if test="fruitFilter.systemResource != null">
                            `fruit`.`system_resource` = #{fruitFilter.systemResource}
                        </if>
                        <if test="fruitFilter.userId != null">
                            `user_id` = #{fruitFilter.userId}
                        </if>
                        <if test="externalResourceIds != null and externalResourceIds.size > 0">
                            `fruit`.id IN
                            <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator=","
                                     close=")">
                                #{externalResourceId}
                            </foreach>
                        </if>
                    </trim>
                    )
                </if>
                <if test="fruitFilter.name != null and fruitFilter.name != ''">
                    <bind name="keyLike" value="'%' + fruitFilter.name + '%'" />
                    AND JSON_EXTRACT(name, CONCAT('$.', #{fruitFilter.languageCode})) LIKE #{keyLike}
                </if>
                <if test="fruitFilter.types != null and !fruitFilter.types.isEmpty">
                    AND `fruit_type` IN
                    <foreach item="type" collection="fruitFilter.types" open="(" separator="," close=")">
                        #{type}
                    </foreach>
                </if>
            </trim>
        </where>
    </sql>


    <!-- Construct order by clause -->
    <sql id="orderClause">
        <choose>
            <when test="sortList == null or sortList.isEmpty">
                creation_record_id DESC
            </when>
            <otherwise>
                <foreach item="item" collection="sortList" separator=",">
                    ${item.sortKey} ${item.sortOrder}
                </foreach>
            </otherwise>
        </choose>
    </sql>
</mapper>