<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yichi.onepiece.fruit.model.FruitDao">
    <select id="listFruits" resultType="com.yichi.onepiece.fruit.model.FruitListView">
        SELECT * FROM `view_fruit_list_view`
        WHERE
        ( user_id = #{userId}
        <if test="externalResourceIds!=null and !externalResourceIds.isEmpty">
            OR
            id IN
            <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator="," close=")">
                #{externalResourceId}
            </foreach>
        </if>
        )
        <include refid="fruitFilter">
            <property name="fruitFilter" value="fruitFilter"/>
        </include>
        ORDER BY
        <include refid="orderClause"/>
        LIMIT #{offset}, #{size}
    </select>

    <select id="searchCount" resultType="int">
        SELECT COUNT(*) FROM fruit
        WHERE
        ( user_id = #{userId}
        <if test="externalResourceIds!=null and !externalResourceIds.isEmpty">
            OR
            id IN
            <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator="," close=")">
                #{externalResourceId}
            </foreach>
        </if>
        )
        <include refid="fruitFilter">
            <property name="fruitFilter" value="fruitFilter"/>
        </include>
    </select>

    <!-- Construct where clause -->
    <sql id="fruitFilter">
        <if test="fruitFilter.onlySystem != null">
            AND `is_system_resource` = #{fruitFilter.onlySystem}
        </if>
        <if test="fruitFilter.name != null and fruitFilter.name != ''">
            <bind name="keyLike" value="'%' + fruitFilter.name + '%'"/>
            AND `name` like #{keyLike}
        </if>
        <if test="fruitFilter.types != null and !fruitFilter.types.isEmpty">
            AND `fruit_type` IN
            <foreach item="type" collection="fruitFilter.types" open="("
              separator="," close=")">
                #{type}
            </foreach>
        </if>
    </sql>

    <!-- Construct order by clause -->
    <sql id="orderClause">
        <choose>
            <when test="sortList == null or sortList.isEmpty">
                creation_record_id DESC
            </when>
            <otherwise>
                <foreach item="item" collection="sortList" separator=",">
                    ${item.sortKey} ${item.sortOrder}
                </foreach>
            </otherwise>
        </choose>
    </sql>
</mapper>