<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yichi.onepiece.group.model.GroupDao">
  <select id="list" resultType="com.yichi.onepiece.group.model.GroupListView" resultMap="groupListView">
    SELECT * FROM `view_group_list_view`
    WHERE (`view_group_list_view`.user_id = #{userId}
    <if test="externalResourceIds!=null and !externalResourceIds.isEmpty">
      OR
      `view_group_list_view`.id IN
      <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator=","
        close=")">
        #{externalResourceId}
      </foreach>
    </if>)
    <include refid="groupFilter">
      <property name="groupFilter" value="groupFilter"/>
    </include>
    GROUP BY `view_group_list_view`.`id`
    ORDER BY
    <include refid="orderClause"/>
    LIMIT #{offset}, #{size}
  </select>

  <select id="searchCount" resultType="int">
    select count(distinct(`view_group_list_view`.id))
    from `view_group_list_view`
    WHERE (`view_group_list_view`.user_id = #{userId}
    <if test="externalResourceIds!=null and !externalResourceIds.isEmpty">
      OR
      `view_group_list_view`.id IN
      <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator=","
        close=")">
        #{externalResourceId}
      </foreach>
    </if>)
    <include refid="groupFilter">
      <property name="groupFilter" value="groupFilter"/>
    </include>
    GROUP BY `view_group_list_view`.`id`
  </select>

  <sql id="groupFilter">
    <if test="groupFilter.name != null and groupFilter.name != ''">
      <bind name="keyLike" value="'%' + groupFilter.name + '%'" />
      AND JSON_EXTRACT(name, CONCAT('$.', #{groupFilter.languageCode})) LIKE #{keyLike}
    </if>
    <if test="groupFilter.category != null and groupFilter.category != ''">
      AND JSON_CONTAINS(category, #{groupFilter.category}, '${groupFilter.languageCode}')
    </if>
    # 海军，海贼，革命军，山贼，七武海，CP9，CP0，神之骑士团，五老星，国王军，海贼猎人，其他组织
    <if test="groupFilter.groupCategories != null and groupFilter.groupCategories.isEmpty">
      AND `category` in
      <foreach item="category" collection="groupFilter.groupCategories" open="("
        separator="," close=")">
        #{category}
      </foreach>
    </if>
  </sql>

  <!-- Construct order by clause -->
  <sql id="orderClause">
    <choose>
      <when test="sortList == null or sortList.isEmpty">
        creation_record_id DESC
      </when>
      <otherwise>
        <foreach item="item" collection="sortList" separator=",">
          ${item.sortKey} ${item.sortOrder}
        </foreach>
      </otherwise>
    </choose>
  </sql>

  <resultMap id="groupListView" type="com.yichi.onepiece.group.model.GroupListView">
    <association column="id" property="characters"
      select="com.yichi.onepiece.character.model.dao.CharacterToGroupDao.listCharacterInGroupLiteByGroupId"
    />
  </resultMap>

</mapper>