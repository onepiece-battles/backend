<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yichi.onepiece.group.model.GroupDao">
  <select id="list" resultType="com.yichi.onepiece.group.model.GroupListView" resultMap="groupListView">
    SELECT DISTINCT `group`.* FROM `group`
    LEFT JOIN `action_lineage` on `group`.`creation_record_id` = `action_lineage`.`id`
    <include refid="groupFilter">
      <property name="groupFilter" value="groupFilter"/>
    </include>
    ORDER BY
    <include refid="orderClause"/>
    LIMIT #{offset}, #{size}
  </select>

  <select id="count" resultType="int">
    select COUNT(distinct(`group`.id)) from `group`
    LEFT JOIN `action_lineage` on `group`.`creation_record_id` = `action_lineage`.`id`
    <include refid="groupFilter">
      <property name="groupFilter" value="groupFilter"/>
    </include>
  </select>

  <sql id="groupFilter">
    <where>
      <trim prefixOverrides="AND">
        <if test="groupFilter.systemResource != null or groupFilter.userId != null or (externalResourceIds != null and externalResourceIds.size > 0)">
          (
          <trim prefixOverrides="OR">
            <if test="groupFilter.systemResource != null">
              `group`.`system_resource` = #{groupFilter.systemResource}
            </if>
            <if test="groupFilter.userId != null">
              OR `user_id` = #{groupFilter.userId}
            </if>
            <if test="externalResourceIds != null and externalResourceIds.size > 0">
              OR `group`.`id` IN
              <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator="," close=")">
                #{externalResourceId}
              </foreach>
            </if>
          </trim>
          )
        </if>
        <if test="groupFilter.noFather != null">
          AND `father_group_id` is null
        </if>
        <if test="groupFilter.excludedGroupIds != null and !groupFilter.excludedGroupIds.isEmpty">
          AND `group`.`id` not in
          <foreach item="excludedId" collection="groupFilter.excludedGroupIds" open="(" separator="," close=")">
            #{excludedId}
          </foreach>
        </if>
        <if test="groupFilter.roleId != null">
          AND `role_id` = #{groupFilter.roleId}
        </if>
        <if test="groupFilter.groupCategories != null and !groupFilter.groupCategories.isEmpty">
          AND `group_category` in
          <foreach item="category" collection="groupFilter.groupCategories" open="(" separator="," close=")">
            #{category}
          </foreach>
        </if>
        <if test="groupFilter.name != null and groupFilter.name != ''">
          <bind name="keyLike" value="'%' + groupFilter.name + '%'" />
          AND JSON_EXTRACT(name, CONCAT('$.', #{groupFilter.languageCode})) LIKE #{keyLike}
        </if>
      </trim>
    </where>
  </sql>


  <!-- Construct order by clause -->
  <sql id="orderClause">
    <choose>
      <when test="sortList == null or sortList.isEmpty">
        creation_record_id DESC
      </when>
      <otherwise>
        <foreach item="item" collection="sortList" separator=",">
          ${item.sortKey} ${item.sortOrder}
        </foreach>
      </otherwise>
    </choose>
  </sql>

  <resultMap id="groupListView" type="com.yichi.onepiece.group.model.GroupListView">
    <result column="id" property="id"/>
    <association column="id" property="characterInGroup"
      select="com.yichi.onepiece.character.model.dao.CharacterToGroupDao.listCharacterInGroupLiteByGroupId"
    />
    <association column="id" property="subGroups"
                 select="com.yichi.onepiece.group.model.GroupDao.listChildGroups"
    />
    <association column="creation_record_id" property="creationRecord"
                 select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
    />
    <association column="modification_record_id" property="modificationRecord"
                 select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
    />
  </resultMap>

  <resultMap id="groupFullView" type="com.yichi.onepiece.group.model.GroupFullView" autoMapping="true" extends="groupListView">
    <association column="id" property="id"
    />
    <association column="id" property="characters"
      select="com.yichi.onepiece.character.model.dao.CharacterToGroupDao.listCharacterInGroupViewByGroupId"
    />
  </resultMap>
</mapper>