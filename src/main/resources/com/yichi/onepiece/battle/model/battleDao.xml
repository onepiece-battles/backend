<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yichi.onepiece.battle.model.BattleDao">
    <select id="list" resultType="com.yichi.onepiece.battle.model.BattleListView" resultMap="battleListView">
        SELECT *
        FROM `battle`
        LEFT JOIN `battle_execution` on `battle`.id = `battle_execution`.`battle_id`
        LEFT JOIN `action_lineage` on `battle`.`creation_record_id` = `action_lineage`.`id`
        LEFT JOIN  `character` as starter on `battle`.`starter_id` = starter.id
        LEFT JOIN  `character` as receiver on `battle`.`receiver_id` = receiver.id
        <include refid="battleFilter">
            <property name="battleFilter" value="battleFilter"/>
        </include>
        ORDER BY
        <include refid="orderClause"/>
        LIMIT #{offset}, #{size}
    </select>

    <select id="searchCount" resultType="int">
        SELECT COUNT(distinct(`battle`.id))
        FROM `battle`
        LEFT JOIN `battle_execution` on `battle`.id = `battle_execution`.`battle_id`
        LEFT JOIN `action_lineage` on `battle`.`creation_record_id` = `action_lineage`.`id`
        LEFT JOIN  `character` as starter on `battle`.`starter_id` = starter.id
        LEFT JOIN  `character` as receiver on `battle`.`receiver_id` = receiver.id
        <include refid="battleFilter">
            <property name="battleFilter" value="battleFilter"/>
        </include>
    </select>

    <!-- Construct where clause -->
    <sql id="battleFilter">
        WHERE (`user_id` = #{userId} OR `battle`.`system_resource` = true
            <if test="externalResourceIds!=null and !externalResourceIds.isEmpty">
                OR
                `battle`.id IN
                <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator="," close=")">
                    #{externalResourceId}
                </foreach>
            </if>
        )
        <if test="battleFilter.userId != null">
            AND `user_id` = #{battleFilter.userId}
        </if>
        <if test="battleFilter.roleId != null">
            AND `role_id` = #{battleFilter.roleId}
        </if>
        <if test="battleFilter.onlySystem != null">
            AND `battle`.`system_resource` = #{battleFilter.onlySystem}
        </if>
        <if test="battleFilter.starterName != null and battleFilter.starterName != ''">
            <bind name="starterKeyLike" value="'%' + battleFilter.starterName + '%'" />
            AND JSON_EXTRACT(`starter`.`name`, CONCAT('$.', #{battleFilter.languageCode})) LIKE #{starterKeyLike}
        </if>
        <if test="battleFilter.receiverName != null and battleFilter.receiverName != ''">
            <bind name="receiverKeyLike" value="'%' + battleFilter.receiverName + '%'" />
            AND JSON_EXTRACT(`receiver`.`name`, CONCAT('$.', #{battleFilter.languageCode})) LIKE #{receiverKeyLike}
        </if>
        <if test="battleFilter.battleTypes != null and !battleFilter.battleTypes.isEmpty">
            AND type IN
            <foreach item="battleType" collection="battleFilter.battleTypes" open="("
                     separator="," close=")">
                #{battleType}
            </foreach>
        </if>
        <if test="battleFilter.battleStatuses != null and !battleFilter.battleStatuses.isEmpty">
            AND `status` IN
            <foreach item="battleStatus" collection="battleFilter.battleStatuses" open="("
                     separator="," close=")">
                #{battleStatus}
            </foreach>
        </if>
    </sql>

    <!-- Construct order by clause -->
    <sql id="orderClause">
        <choose>
            <when test="sortList == null or sortList.isEmpty">
                `battle`.`creation_record_id` DESC
            </when>
            <otherwise>
                <foreach item="item" collection="sortList" separator=",">
                    ${item.sortKey} ${item.sortOrder}
                </foreach>
            </otherwise>
        </choose>
    </sql>

    <select id="getBattleFullView" resultMap="battleFullView" resultType="com.yichi.onepiece.battle.model.BattleFullView">
        SELECT * FROM `battle`
        LEFT JOIN `battle_execution` on `battle`.id = `battle_execution`.`battle_id`
        LEFT JOIN `action_lineage` on `battle`.`creation_record_id` = `action_lineage`.`id`
        WHERE `battle`.id = #{id}
    </select>

    <resultMap id="battleListView" type="com.yichi.onepiece.battle.model.BattleListView" autoMapping="true">
        <result column="id" property="id"/>
        <result column="starter_id" property="starterId"/>
        <result column="receiver_id" property="receiverId"/>
        <result column="creation_record_id" property="creationRecordId"
        />
        <result column="modification_record_id" property="modificationRecordId"
        />
        <association column="id" property="battleExecution"
                     select="com.yichi.onepiece.battle.model.BattleExecutionDao.findByBattleId"/>
        <association column="starter_id" property="starter"
                     select="com.yichi.onepiece.character.model.dao.CharacterDao.findById"
        />
        <association column="receiver_id" property="receiver"
                     select="com.yichi.onepiece.character.model.dao.CharacterDao.findById"
        />
        <association column="creation_record_id" property="creationRecord"
                     select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
        />
        <association column="modification_record_id" property="modificationRecord"
                     select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
        />
    </resultMap>

    <resultMap id="battleFullView" type="com.yichi.onepiece.battle.model.BattleFullView"
      autoMapping="true" extends="battleListView">
        <result column="id" property="id"/>
        <association column="id" property="battleStatusDetails"
          select="com.yichi.onepiece.battle.model.BattleStatusDetailDao.listByBattleId"/>
        <association column="id" property="battleProcessDetails"
          select="com.yichi.onepiece.battle.model.BattleProcessDetailDao.listByBattleId"/>
    </resultMap>
</mapper>