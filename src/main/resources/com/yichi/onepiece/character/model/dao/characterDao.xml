<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yichi.onepiece.character.model.dao.CharacterDao">
    <select id="list" resultType="com.yichi.onepiece.character.model.entity.CharacterListView" resultMap="characterListView">
        SELECT DISTINCT `character`.*
        FROM `character`
            LEFT JOIN `character_to_fruit` ON `character`.`id` = `character_to_fruit`.`character_id`
            LEFT JOIN `haki` on `character`.id = `haki`.character_id
            LEFT JOIN `action_lineage` on `character`.`creation_record_id` = `action_lineage`.`id`
        <include refid="characterFilter">
            <property name="characterFilter" value="characterFilter"/>
        </include>
        ORDER BY
        <include refid="orderClause"/>
        LIMIT #{offset}, #{size}
    </select>

    <select id="getFullViewById" resultType="com.yichi.onepiece.character.model.entity.CharacterFullView" resultMap="characterFullView">
        SELECT * FROM `character`
        WHERE `character`.id = #{id}
        GROUP BY `character`.`id`
    </select>

    <select id="count" resultType="int">
        SELECT COUNT(distinct(`character`.id))
        FROM `character`
            LEFT JOIN `character_to_fruit` ON `character`.`id` = `character_to_fruit`.`character_id`
            LEFT JOIN `haki` on `haki`.character_id = `character`.id
            LEFT JOIN `action_lineage` on `character`.`creation_record_id` = `action_lineage`.`id`
        <include refid="characterFilter">
            <property name="characterFilter" value="characterFilter"/>
        </include>
    </select>

    <sql id="characterFilter">
        <where>
            <trim prefixOverrides="AND">
                <if test="characterFilter.systemResource != null or characterFilter.userId != null or (externalResourceIds != null and externalResourceIds.size > 0)">
                    (
                    <trim prefixOverrides="OR">
                        <if test="characterFilter.systemResource != null">
                            `system_resource` = #{characterFilter.systemResource}
                        </if>
                        <if test="characterFilter.userId != null">
                            `user_id` = #{characterFilter.userId}
                        </if>
                        <if test="externalResourceIds != null and externalResourceIds.size > 0">
                            `character`.`id` IN
                            <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator=","
                                     close=")">
                                #{externalResourceId}
                            </foreach>
                        </if>
                    </trim>
                    )
                </if>
                <if test="characterFilter.excludedCharacterIds != null and !characterFilter.excludedCharacterIds.isEmpty">
                    AND `character`.`id` NOT IN
                    <foreach item="excludedId" collection="characterFilter.excludedCharacterIds" open="(" separator="," close=")">
                        #{excludedId}
                    </foreach>
                </if>
                <if test="characterFilter.roleId != null">
                    AND `role_id` = #{characterFilter.roleId}
                </if>
                <if test="characterFilter.name != null and characterFilter.name != ''">
                    <bind name="keyLike" value="'%' + characterFilter.name + '%'" />
                    AND JSON_EXTRACT(name, CONCAT('$.', #{characterFilter.languageCode})) LIKE #{keyLike}
                </if>
                <if test="characterFilter.hasFruit != null">
                    AND (`character_to_fruit`.`fruit_id` IS NOT NULL) = #{characterFilter.hasFruit}
                </if>
                <if test="characterFilter.battleStyles != null and !characterFilter.battleStyles.isEmpty">
                    AND `battle_style` IN
                    <foreach item="battleStyle" collection="characterFilter.battleStyles" open="(" separator="," close=")">
                        #{battleStyle}
                    </foreach>
                </if>
                <if test="characterFilter.races != null and !characterFilter.races.isEmpty">
                    AND `race` IN
                    <foreach item="race" collection="characterFilter.races" open="(" separator="," close=")">
                        #{race}
                    </foreach>
                </if>
                <if test="characterFilter.hakis != null and !characterFilter.hakis.isEmpty">
                    AND `haki`.`haki` IN
                    <foreach item="haki" collection="characterFilter.hakis" open="(" separator="," close=")">
                        #{haki}
                    </foreach>
                </if>
            </trim>
        </where>
    </sql>



    <!-- Construct order by clause -->
    <sql id="orderClause">
        <choose>
            <when test="sortList == null or sortList.isEmpty">
                creation_record_id DESC
            </when>
            <otherwise>
                <foreach item="item" collection="sortList" separator=",">
                    ${item.sortKey} ${item.sortOrder}
                </foreach>
            </otherwise>
        </choose>
    </sql>
    
    <resultMap id="characterFullView" type="com.yichi.onepiece.character.model.entity.CharacterFullView" autoMapping="true" extends="characterListView">
        <association column="id" property="battles"
          select="com.yichi.onepiece.battle.model.BattleDao.listBattlesByCharacterId"
        />
        <association column="id" property="fruits"
          select="com.yichi.onepiece.fruit.model.FruitDao.listByCharacterId"
        />
        <association column="id" property="fruitInCharacter"
          select="com.yichi.onepiece.character.model.dao.CharacterToFruitDao.listByCharacterId"
        />
        <association column="id" property="groups"
          select="com.yichi.onepiece.character.model.dao.CharacterToGroupDao.listGroupForCharacterViewByCharacterId"
        />
    </resultMap>

    <resultMap id="characterListView" type="com.yichi.onepiece.character.model.entity.CharacterListView" autoMapping="true">
        <association column="id" property="id"
        />
        <association column="id" property="hakis"
                     select="com.yichi.onepiece.character.model.dao.HakiDao.listByCharacterId"
        />
        <association column="creation_record_id" property="creationRecord"
                     select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
        />
        <association column="modification_record_id" property="modificationRecord"
                     select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
        />
    </resultMap>
</mapper>