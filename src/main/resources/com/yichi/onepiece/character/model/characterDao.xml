<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yichi.onepiece.character.model.dao.CharacterDao">
    <select id="list" resultType="com.yichi.onepiece.character.model.entity.CharacterListView" resultMap="characterListView">
        SELECT * FROM `view_character_list_view`
        WHERE
        ( `view_character_list_view`.user_id = #{userId}
        <if test="externalResourceIds!=null and !externalResourceIds.isEmpty">
            OR
            `view_character_list_view`.id IN
            <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator="," close=")">
                #{externalResourceId}
            </foreach>
        </if>
        )
        <include refid="characterFilter">
            <property name="characterFilter" value="characterFilter"/>
        </include>
        GROUP BY `view_character_list_view`.`id`
        ORDER BY
        <include refid="orderClause"/>
        LIMIT #{offset}, #{size}
    </select>

    <select id="getFullViewById" resultType="com.yichi.onepiece.character.model.entity.CharacterFullView" resultMap="characterFullView">
        SELECT * FROM `view_character_list_view`
        WHERE `view_character_list_view`.id = #{id}
        GROUP BY `view_character_list_view`.`id`
    </select>

    <select id="searchCount" resultType="int">
        select count(distinct(`view_character_list_view`.id))
        FROM `view_character_list_view`
        WHERE
        ( user_id = #{userId}
        <if test="externalResourceIds!=null and !externalResourceIds.isEmpty">
            OR
            `view_character_list_view`.id IN
            <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator="," close=")">
                #{externalResourceId}
            </foreach>
        </if>
        )
        <include refid="characterFilter">
            <property name="characterFilter" value="characterFilter"/>
        </include>
    </select>

    <!-- Construct where clause -->
    <sql id="characterFilter">
        <if test="characterFilter.name != null and characterFilter.name != ''">
            AND JSON_CONTAINS(name, #{characterFilter.name}, '${characterFilter.languageCode}')
        </if>
        <if test="characterFilter.hasFruit != null">
            AND (`fruit_id` IS NOT NULL) = #{characterFilter.hasFruit}
        </if>
        <if test="characterFilter.onlySystem != null">
            AND `system_resource` = #{characterFilter.onlySystem}
        </if>
        <if test="characterFilter.characterTypes != null and !characterFilter.characterTypes.isEmpty">
            AND `character_type`.`character_type` in
            <foreach item="characterType" collection="characterFilter.characterTypes" open="("
                     separator="," close=")">
                #{characterType}
            </foreach>
        </if>
        <if test="characterFilter.hakis != null and !characterFilter.hakis.isEmpty">
            AND `haki`.`haki` in
            <foreach item="haki" collection="characterFilter.hakis" open="("
                     separator="," close=")">
                #{haki}
            </foreach>
        </if>
    </sql>

    <!-- Construct order by clause -->
    <sql id="orderClause">
        <choose>
            <when test="sortList == null or sortList.isEmpty">
                creation_record_id DESC
            </when>
            <otherwise>
                <foreach item="item" collection="sortList" separator=",">
                    ${item.sortKey} ${item.sortOrder}
                </foreach>
            </otherwise>
        </choose>
    </sql>
    
    <resultMap id="characterFullView" type="com.yichi.onepiece.character.model.entity.CharacterFullView" autoMapping="true" extends="characterListView">
        <association column="id" property="battles"
          select="com.yichi.onepiece.battle.model.BattleDao.listBattlesByCharacterId"
        />
        <association column="id" property="fruits"
          select="com.yichi.onepiece.fruit.model.FruitDao.listByCharacterId"
        />
        <association column="id" property="fruitInCharacter"
          select="com.yichi.onepiece.character.model.dao.CharacterToFruitDao.listByCharacterId"
        />
        <association column="id" property="groups"
          select="com.yichi.onepiece.group.model.GroupDao.listGroupsByCharacterId"
        />
    </resultMap>

    <resultMap id="characterListView" type="com.yichi.onepiece.character.model.entity.CharacterListView" autoMapping="true">
        <association column="id" property="id"
        />
        <association column="id" property="characterTypes"
                     select="com.yichi.onepiece.character.model.dao.CharacterTypeDao.listByCharacterId"
        />
        <association column="id" property="hakis"
                     select="com.yichi.onepiece.character.model.dao.HakiDao.listByCharacterId"
        />
    </resultMap>
</mapper>