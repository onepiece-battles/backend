<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yichi.onepiece.character.model.CharacterDao">
    <select id="list" resultType="com.yichi.onepiece.character.model.CharacterListView" resultMap="characterListView">
        SELECT * FROM `view_character_list_view`
        WHERE
        ( user_id = #{userId}
        <if test="externalResourceIds!=null and !externalResourceIds.isEmpty">
            OR
            id IN
            <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator="," close=")">
                #{externalResourceId}
            </foreach>
        </if>
        )
        <include refid="characterFilter">
            <property name="characterFilter" value="characterFilter"/>
        </include>
        ORDER BY
        <include refid="orderClause"/>
        LIMIT #{offset}, #{size}
    </select>

    <select id="searchCount" resultType="int">
        SELECT COUNT(*) FROM `character`
        WHERE
        ( user_id = #{userId}
        <if test="externalResourceIds!=null and !externalResourceIds.isEmpty">
            OR
            id IN
            <foreach item="externalResourceId" collection="externalResourceIds" open="(" separator="," close=")">
                #{externalResourceId}
            </foreach>
        </if>
        )
        <include refid="characterFilter">
            <property name="characterFilter" value="characterFilter"/>
        </include>
    </select>

    <!-- Construct where clause -->
    <sql id="characterFilter">
        <if test="characterFilter.name != null and characterFilter.name != ''">
            <bind name="keyLike" value="'%' + characterFilter.name + '%'"/>
            AND `name` like #{keyLike}
        </if>
        <if test="characterFilter.hasFruit != null">
            AND `has_fruit` = #{characterFilter.hasFruit}
        </if>
        <if test="characterFilter.onlySystem != null">
            AND `system_resource` = #{characterFilter.onlySystem}
        </if>
        <if test="characterFilter.characterTypes != null and !characterFilter.characterTypes.isEmpty">
            AND EXISTS
            (
            select 1 from `character_type` where `character_type` in
                <foreach item="characterType" collection="characterFilter.characterTypes" open="("
                         separator="," close=")">
                    #{characterType}
                </foreach>
            )
        </if>
    </sql>

    <!-- Construct order by clause -->
    <sql id="orderClause">
        <choose>
            <when test="sortList == null or sortList.isEmpty">
                creation_record_id DESC
            </when>
            <otherwise>
                <foreach item="item" collection="sortList" separator=",">
                    ${item.sortKey} ${item.sortOrder}
                </foreach>
            </otherwise>
        </choose>
    </sql>
    
    <resultMap id="characterFullView" type="com.yichi.onepiece.character.model.CharacterFullView">
        <association column="creation_record_id" property="creationRecord"
          select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
        />
        <association column="modification_record_id" property="modificationRecord"
          select="com.yichi.onepiece.lineage.model.ActionRecordDao.findById"
        />
        <association column="id" property="battles"
          select="com.yichi.onepiece.battle.model.BattleDao.listBattlesByCharacterId"
        />
        <association column="id" property="fruits"
          select="com.yichi.onepiece.fruit.model.FruitDao.listByCharacterId"
        />
        <association column="id" property="fruitInCharacter"
          select="com.yichi.onepiece.character.model.CharacterToFruitDao.listByCharacterId"
        />
        <association column="id" property="groups"
          select="com.yichi.onepiece.group.model.GroupDao.listGroupsByCharacterId"
        />
    </resultMap>

    <resultMap id="characterListView" type="com.yichi.onepiece.character.model.CharacterListView" autoMapping="true">
        <association column="id" property="id"
        />
        <association column="id" property="characterTypes"
                     select="com.yichi.onepiece.character.model.CharacterTypeDao.listByCharacterId"
        />
        <association column="id" property="hakis"
                     select="com.yichi.onepiece.character.model.HakiDao.listByCharacterId"
        />
    </resultMap>
</mapper>